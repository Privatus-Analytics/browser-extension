{
  "manifest_version": 3,
  "name": "Privatus Analytics – Block my visits",
  "short_name": "Privatus Analytics opt-out",
  "version": "1.0.2",
  "description": "Stop counting your own visits in Privatus Analytics, so your stats show only real visitors. Collects nothing.",
  "homepage_url": "https://privatusanalytics.com/docs/tracker/opt-out",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Privatus Analytics – Block my visits",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/core.js", "background.js"]
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "scripting",
    "activeTab"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "block-my-visits@privatusanalytics.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
